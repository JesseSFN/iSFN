# Kopieer dit bestand naar ".env" en pas het aan:  cp .env.example .env

# Wachtwoord voor de beheerpagina (verplicht, minimaal 8 tekens). Kies iets lasts.
ADMIN_PASSWORD=verander-dit-wachtwoord

# Poort op de computer waarop het spel bereikbaar is (standaard 8080).
HOST_PORT=8080

# Alleen instellen als je de site via een reverse proxy met https aanbiedt (zie README):
# TRUST_PROXY=1
# COOKIE_SECURE=1

# Maximale grootte van een geüpload bestand in MB (standaard 50).
# MAX_UPLOAD_MB=50
